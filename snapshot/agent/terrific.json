    "tasks": {
      "compression": {
        "thinking": "low",
        "timeoutMs": 120000,
        "maxOutputTokens": 12000,
        "maxRetries": 0,
        "model": "openai/gpt-5.6-luna"
      },
      "title_generation": {
        "maxOutputTokens": 96,
        "timeoutMs": 30000,
        "model": "openai/gpt-5.6-luna"
      },
      "text_summary": {
        "maxOutputTokens": 3000,
