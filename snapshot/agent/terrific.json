{
  "auxiliary": {
    "enabled": true,
    "default": {
      "model": "openai/gpt-5.6-luna",
      "thinking": "high",
      "timeoutMs": 60000,
      "maxOutputTokens": 2048,
      "maxRetries": 1,
      "fallbackModels": []
