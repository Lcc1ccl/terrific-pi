{
  "name": "pilot",
  "version": "0.2.0",
  "description": "Manual human-in-the-loop Copilot for constrained primary-solo Pi work",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "pilot", "workflow"],
  "license": "MIT",
  "pi": {
    "extensions": ["./extensions/pilot.ts"],
    "subagents": {
      "agents": ["./agents"]
    }
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  },
  "files": ["agents", "extensions", "lib", "package.json", "README.md", "tsconfig.json"]
}
