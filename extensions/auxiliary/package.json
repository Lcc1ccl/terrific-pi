{
  "name": "auxiliary",
  "version": "0.1.0",
  "description": "Task-scoped auxiliary model runtime for pi",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "auxiliary-model", "sidecar"],
  "license": "MIT",
  "pi": {
    "extensions": ["./extensions/auxiliary.ts"]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@types/node": "^26.0.0",
    "typebox": "1.1.38",
    "typescript": "^6.0.3"
  },
  "files": ["extensions", "lib", "package.json", "README.md", "tsconfig.json"]
}
