{
  "name": "appearance",
  "version": "0.1.0",
  "description": "Native Pi TUI appearance shell",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "pi-theme"],
  "license": "MIT",
  "pi": {
    "extensions": ["./extensions/appearance.ts"],
    "themes": ["./themes"]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "benchmark": "node --experimental-strip-types benchmarks/render.bench.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "files": ["extensions", "lib", "themes", "README.md", "package.json"]
}
