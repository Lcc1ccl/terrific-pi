    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "extensions",
    "lib",
    "examples",
    "package.json",
    "README.md",
    "tsconfig.json"
  ]
}
