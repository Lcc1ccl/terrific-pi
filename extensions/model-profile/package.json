{
  "name": "model-profile",
  "version": "0.2.0",
  "description": "Short-list model+thinking profiles for Pi (/profile): session/global apply, hotkeys, cold-start picker.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-profile",
    "model",
    "thinking"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/model-profile.ts"
    ]
  },
  "scripts": {
