{
  "name": "context",
  "version": "0.1.0",
  "description": "Pi /context occupancy inspector with explicit confirmed compaction",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/context.ts"
    ]
  },
  "scripts": {
