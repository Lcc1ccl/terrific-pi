  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "extensions",
    "lib",
    "examples",
    "package.json",
    "README.md",
    "tsconfig.json"
  ]
}
