{
  "name": "mode",
  "version": "0.1.0",
  "description": "Pi /mode tool-permission modes: ask | plan | edit | auto",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mode"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/mode.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "benchmark": "node --experimental-strip-types benchmarks/render.bench.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "extensions",
    "lib",
    "examples",
    "package.json",
    "README.md",
    "tsconfig.json"
  ]
}
